# Copy this file to `backend/.env` and fill in your Supabase values.
# `.env` is gitignored — never commit real credentials.
#
# Get these from: Supabase Dashboard -> Project Settings -> Database
#   -> "Connection pooling" -> Mode: Session (port 5432)
# The Session Pooler is IPv4-friendly and works with Flyway.

# JDBC URL. Replace <region> and keep sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Username is literally: postgres.<your-project-ref>
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>

# Your Supabase database password.
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password

# --- Optional overrides ---
# HikariCP pool sizing (defaults: 5 / 1).
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=1

# Override the seeded admin credentials (recommended for any shared Supabase instance).
# APP_ADMIN_EMAIL=admin@wedding.test
# APP_ADMIN_PASSWORD=change-this-strong-password

# HS256 JWT signing secret (>= 32 bytes). Override for anything non-local.
# APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
